# ==============================================================================
# Form 3D — Environment Configuration Template
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Optional: Remote Google Colab GPU Worker (Cloudflare Tunnel URL)
# When set, Step 5 mesh generation offloads to your remote A100/L4 GPU worker.
# Leave blank to run natively on Apple Silicon Metal Performance Shaders (MPS).
# COLAB_BACKEND_URL=https://your-tunnel.trycloudflare.com

# Optional: Path to Antigravity CLI binary
# By default, Form 3D auto-discovers `agy` from PATH, ~/.local/bin, or ~/.gemini/antigravity-cli/bin
# AGY_PATH=/Users/yourname/.local/bin/agy

# Compute Device Override (mps, cuda, cpu)
# Defaults to 'mps' on Apple Silicon macOS, 'cuda' if NVIDIA GPU available, or 'cpu' fallback
# COMPUTE_DEVICE=mps
